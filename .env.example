# ==============================================================================
# Supabase Database & API Credentials
# ==============================================================================
# Supabase PostgreSQL Connection URI (Preferred: Use Transaction Pooler on port 6543)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Project URL and Keys
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Legacy / Previous Database Credentials (Optional - only needed if running scripts/migrate-turso-to-supabase.js)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Authentication Secret — REQUIRED for user auth (server-side only, never expose to frontend)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Security Authentication Keys (server-side only, never prefix with VITE_)
API_SECRET_KEY=your_api_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here

# Optional: Initial Administrator account (created on first startup if set)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your_secure_admin_password_here
# ADMIN_NAME=Administrator

# Optional: Restrict CORS to a specific origin in production
# ALLOWED_ORIGIN=https://your-app.vercel.app
