# Database Credentials (Turso libSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Authentication Secret — REQUIRED for user auth (server-side only, never expose to frontend)
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')" | pbcopy
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Security Authentication Keys
API_SECRET_KEY=your_api_secret_key_here
ADMIN_SECRET=your_admin_secret_key_here
VITE_API_SECRET_KEY=your_api_secret_key_here
VITE_ADMIN_SECRET=your_admin_secret_key_here

# Optional: Initial Administrator account (created on first startup if set)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your_secure_admin_password_here
# ADMIN_NAME=Administrator

# Optional: Restrict CORS to a specific origin in production
# ALLOWED_ORIGIN=https://your-app.vercel.app
